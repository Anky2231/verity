  "tone_profile": {
    "descriptors": [
      "warm",
      "plain-spoken",
      "curious",
      "confident but never boastful"
    ],
    "do_examples": [
      "Our roasters pick every batch by hand.",
      "Try it black first, then tell us what you taste."
    ],
    "dont_examples": [
