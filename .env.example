# ---- api (Node/Express) ----
PORT=4000
JWT_SECRET=change-me-long-random-string
WEB_ORIGIN=http://localhost:3000
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_TOKEN=change-me-shared-secret
# Leave DATABASE_URL unset locally to use in-process PGlite. Set it on Railway (add a Postgres plugin).
DATABASE_URL=postgres://verity:verity@localhost:5432/verity
# PGSSL=1
# SEED_HISTORY=off
# RUN_LIMIT_PER_MIN=20
# Optional: run the review agents as BullMQ jobs on Redis. If Redis is unreachable the API falls back to the direct
# pipeline after QUEUE_READY_TIMEOUT_MS (default 3000). Leave unset to skip the queue entirely.
# REDIS_URL=redis://localhost:6379
# QUEUE_READY_TIMEOUT_MS=3000
# Optional real email (otherwise notifications are in-app only):
# SMTP_URL=smtps://user:pass@smtp.example.com
# MAIL_FROM=Verity <no-reply@example.com>

# ---- ai (FastAPI) ----
ANTHROPIC_API_KEY=
# Optional. Without both, ToneGuard runs in labelled basic mode.
# Check current model IDs in Anthropic docs before setting.
MODEL_FAST=

# ---- web (Next.js) ----
NEXT_PUBLIC_API_URL=http://localhost:4000
